# Original source snapshot (cloned by tools/fetch_reference.ps1, never committed)
/reference/

# Godot
.godot/
# uids of generated scripts: nothing refers to them by uid, Godot recreates them on import
/src/content/scripts/**/*.uid
/src/runtime/dws/stubs/*.uid
*.import.tmp
/android/

# C++ core (docs/native.md): godot-cpp and the API dump are fetched by tools/fetch_godot_cpp.ps1, the library and
# object files are built by tools/build_native.ps1
/native/godot-cpp/
/native/extension_api.json
/native/**/*.obj
/native/**/*.os
/native/**/*.o
/native/.sconsign.dblite
/bin/

# Build output and logs
/build/
/logs/
*.log

# Python
__pycache__/
*.pyc

# OS / editors
Thumbs.db
.DS_Store
.vscode/

# Generated by tools/import_graphics.py from reference/ (setup step)
/assets/graphics/
