; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rise of Legions (Godot port)"
config/description="1:1 Godot port of Rise of Legions, last version before the Crystal Clash rebrand."
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"

[shader_globals]

rol_ambient={
"type": "vec3",
"value": Vector3(0.7, 0.7, 0.7)
}
rol_light_count={
"type": "int",
"value": 0
}
rol_light_dir_0={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
rol_light_dir_1={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
rol_light_dir_2={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
rol_light_dir_3={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
rol_light_color_0={
"type": "color",
"value": Color(1, 1, 1, 0)
}
rol_light_color_1={
"type": "color",
"value": Color(1, 1, 1, 0)
}
rol_light_color_2={
"type": "color",
"value": Color(1, 1, 1, 0)
}
rol_light_color_3={
"type": "color",
"value": Color(1, 1, 1, 0)
}
rol_toon_enabled={
"type": "bool",
"value": false
}
rol_toon_border={
"type": "sampler2D",
"value": ""
}
rol_toon_border_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
rol_toon_border_gradient={
"type": "float",
"value": 1.0
}
rol_toon_border_threshold={
"type": "float",
"value": 1.0
}
